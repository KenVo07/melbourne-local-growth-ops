{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "allowJs": true,
    "checkJs": false,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,
    "jsx": "react-jsx",
    "types": [
      "node"
    ],
    "lib": [
      "ES2024",
      "DOM"
    ],
    "module": "preserve",
    "moduleResolution": "bundler"
  },
  "include": [
    "**/*.ts",
    "**/*.mjs"
  ]
}
