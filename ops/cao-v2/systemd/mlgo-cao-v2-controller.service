[Unit]
Description=MLGO CAO v2 deterministic phase controller
After=mlgo-cao.service mlgo-cao-agy-sidecar.service

[Service]
Type=simple
ExecStart=%h/.local/bin/mlgo-v2-controller controller-serve --interval 2
Restart=on-failure
RestartSec=3
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/.local/state/mlgo-cao %h/Projects %h/.local/share %h/.config/mlgo-cao
LockPersonality=yes
RestrictRealtime=yes
SystemCallArchitectures=native

[Install]
WantedBy=default.target
