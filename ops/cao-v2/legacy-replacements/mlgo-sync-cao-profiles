#!/usr/bin/env python3
"""Validate and atomically synchronize canonical MLGO CAO profiles."""

from __future__ import annotations

import argparse
import hashlib
import json
import os
import re
import shutil
import sys
import tempfile
import subprocess
from datetime import datetime
from pathlib import Path

HOME = Path.home()
SOURCE = HOME / ".config/mlgo-cao/profiles"
MAIN = HOME / ".aws/cli-agent-orchestrator/agent-store"
MAIN_CONTEXT = HOME / ".aws/cli-agent-orchestrator/agent-context"
SIDECAR = HOME / ".local/state/mlgo-cao/agy-sidecar/cao-home/agent-store"
BACKUPS = HOME / ".local/state/mlgo-cao/backups/profile-sync"
GENERATOR = HOME / ".local/share/mlgo-cao-v2/profile-sources/generate_profiles.py"
REGISTRY = HOME / ".local/share/mlgo-cao-v2/registry/provider-registry.json"
RETIRED = {
    "mlgo-codex-builder", "mlgo-codex-reviewer", "mlgo-agy-worker",
    "mlgo-agy-reviewer", "mlgo-claude-builder", "mlgo-claude-architect",
}
NAME_RE = re.compile(r"^name:\s*([a-z0-9][a-z0-9-]*)\s*$", re.MULTILINE)
PROVIDER_RE = re.compile(r"^provider:\s*(codex|claude_code|antigravity_cli)\s*$", re.MULTILINE)


def load_registry() -> dict[str, object]:
    if not REGISTRY.is_file():
        raise ValueError(f"canonical provider registry is not installed: {REGISTRY}")
    data = json.loads(REGISTRY.read_text(encoding="utf-8"))
    if data.get("schema_version") != "1.0" or not isinstance(data.get("profiles"), dict):
        raise ValueError("invalid canonical provider registry")
    return data


def profile_sets() -> tuple[set[str], set[str], set[str], set[str]]:
    data = load_registry(); profiles = data["profiles"]
    main = {name for name, cfg in profiles.items() if cfg.get("store") == "main"}
    sidecar = {name for name, cfg in profiles.items() if cfg.get("store") == "sidecar"}
    supervisors = {name for name, cfg in profiles.items() if cfg.get("role_id") == "supervisor"}
    tech_leads = {name for name, cfg in profiles.items() if cfg.get("role_id") == "tech_lead"}
    if main & sidecar or main | sidecar != set(profiles):
        raise ValueError("registry profile store projection is incomplete or overlapping")
    return main, sidecar, supervisors, tech_leads



def profile_body(path: Path) -> str:
    parts = path.read_text(encoding="utf-8").split("---", 2)
    if len(parts) != 3:
        raise ValueError(f"invalid frontmatter/body split: {path}")
    return parts[2].strip()


def validate_shared_bodies() -> None:
    _, _, supervisors, tech_leads = profile_sets()
    for label, names in (("supervisor", supervisors), ("tech-lead", tech_leads)):
        bodies = {profile_body(SOURCE / f"{name}.md") for name in names}
        if len(bodies) != 1:
            raise ValueError(f"{label} canonical bodies diverged; use provider frontmatter only")


def digest(path: Path) -> str:
    return hashlib.sha256(path.read_bytes()).hexdigest()


def validate(name: str) -> Path:
    path = SOURCE / f"{name}.md"
    if not path.is_file() or path.is_symlink():
        raise ValueError(f"missing regular source profile: {path}")
    text = path.read_text(encoding="utf-8")
    if not text.startswith("---\n") or text.count("---") < 2:
        raise ValueError(f"invalid frontmatter: {path}")
    match = NAME_RE.search(text)
    if not match or match.group(1) != name:
        raise ValueError(f"profile name mismatch: {path}")
    if not PROVIDER_RE.search(text):
        raise ValueError(f"missing or invalid provider: {path}")
    if "MLGO_ASYNC_WORKER_COMPLETION" in text:
        raise ValueError(f"obsolete callback block remains: {path}")
    if name in RETIRED:
        raise ValueError(f"retired profile in source selection: {path}")
    return path


def expected(names: set[str]) -> dict[str, Path]:
    if not GENERATOR.is_file():
        raise ValueError(f"canonical profile generator is not installed: {GENERATOR}")
    proc = subprocess.run([sys.executable, str(GENERATOR), "--check", "--output", str(SOURCE)], text=True, capture_output=True)
    if proc.returncode != 0:
        raise ValueError(f"canonical profiles are not exact generated artifacts: {proc.stderr.strip() or proc.stdout.strip()}")
    validate_shared_bodies()
    return {name: validate(name) for name in sorted(names)}


def ensure_private_directory(path: Path) -> None:
    """Idempotently create a persistent directory and enforce mode 0700."""
    try:
        path.mkdir(parents=True, exist_ok=True, mode=0o700)
        if path.is_symlink() or not path.is_dir():
            raise RuntimeError(f"persistent path is not a private directory: {path}")
        path.chmod(0o700)
        actual_mode = path.stat().st_mode & 0o777
        if actual_mode != 0o700:
            raise PermissionError(f"could not enforce mode 0700 on {path}; mode is {actual_mode:04o}")
    except PermissionError as exc:
        raise PermissionError(f"cannot securely initialize persistent directory {path}: {exc}") from exc
    except OSError as exc:
        raise RuntimeError(f"cannot initialize persistent directory {path}: {exc}") from exc


def verify_store(destination: Path, names: set[str]) -> list[str]:
    errors: list[str] = []
    wanted = expected(names)
    if not destination.is_dir():
        return [f"missing destination: {destination}"]
    actual = {p.stem for p in destination.glob("mlgo-*.md") if p.is_file()}
    if actual != names:
        errors.append(f"profile set mismatch at {destination}: expected={sorted(names)} actual={sorted(actual)}")
    for name, source in wanted.items():
        target = destination / f"{name}.md"
        if not target.is_file() or digest(source) != digest(target):
            errors.append(f"content mismatch: {target}")
        elif target.stat().st_mode & 0o777 != 0o600:
            errors.append(f"mode mismatch: {target}")
    if destination.stat().st_mode & 0o777 != 0o700:
        errors.append(f"directory mode mismatch: {destination}")
    return errors


def backup_paths(paths: list[Path], label: str) -> Path | None:
    existing = [p for p in paths if p.exists()]
    if not existing:
        return None
    ensure_private_directory(BACKUPS)
    stamp = datetime.now().strftime("%Y%m%d-%H%M%S-%f")
    root = BACKUPS / f"{stamp}-{label}"
    # This timestamped backup directory is unique and must fail on collision.
    root.mkdir(mode=0o700)
    os.chmod(root, 0o700)
    for index, path in enumerate(existing):
        target = root / f"{index:03d}-{path.parent.name}-{path.name}"
        shutil.copy2(path, target)
        os.chmod(target, 0o600)
    return root


def sync_store(destination: Path, names: set[str], dry_run: bool) -> dict[str, object]:
    wanted = expected(names)
    existing = sorted(p for p in destination.glob("mlgo-*.md") if p.is_file()) if destination.exists() else []
    changed = [destination / f"{n}.md" for n, src in wanted.items() if not (destination / f"{n}.md").is_file() or digest(src) != digest(destination / f"{n}.md")]
    removed = [p for p in existing if p.stem not in names]
    if dry_run:
        return {"destination": str(destination), "changed": [str(p) for p in changed], "removed": [str(p) for p in removed]}
    destination.mkdir(parents=True, exist_ok=True, mode=0o700)
    private_paths = [destination]
    if destination == SIDECAR:
        private_paths.extend([SIDECAR.parent, SIDECAR.parent.parent])
    for path in private_paths:
        os.chmod(path, 0o700)
    backup = backup_paths(existing, destination.parent.name)
    for name, source in wanted.items():
        fd, tmp_name = tempfile.mkstemp(prefix=f".{name}.", dir=destination)
        try:
            with os.fdopen(fd, "wb") as handle:
                handle.write(source.read_bytes())
                handle.flush()
                os.fsync(handle.fileno())
            os.chmod(tmp_name, 0o600)
            os.replace(tmp_name, destination / f"{name}.md")
        finally:
            if os.path.exists(tmp_name):
                os.unlink(tmp_name)
    for path in removed:
        path.unlink()
    return {"destination": str(destination), "changed": [str(p) for p in changed], "removed": [str(p) for p in removed], "backup": str(backup) if backup else None}


def clean_retired(dry_run: bool) -> list[str]:
    # agent-context is generated install residue, not the canonical editable
    # source. Remove every MLGO copy there so shadow profiles cannot reappear
    # when an active-store file is absent. Canonical files remain under SOURCE.
    paths = [root / f"{name}.md" for root in (MAIN, SIDECAR) for name in RETIRED]
    paths.extend(MAIN_CONTEXT.glob("mlgo-*.md"))
    existing = [p for p in paths if p.exists()]
    if dry_run or not existing:
        return [str(p) for p in existing]
    backup = backup_paths(existing, "retired")
    if backup is None:
        raise RuntimeError("retired backup was not created")
    for path in existing:
        path.unlink()
    return [str(p) for p in existing]


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    group = parser.add_mutually_exclusive_group(required=True)
    group.add_argument("--dry-run", action="store_true", help="Show changes for both stores without writing")
    group.add_argument("--verify", action="store_true", help="Verify both stores and retired-profile absence")
    group.add_argument("--main", action="store_true", help="Synchronize the main CAO profile store")
    group.add_argument("--agy-sidecar", action="store_true", help="Synchronize the AGY sidecar store")
    group.add_argument("--all", action="store_true", help="Synchronize both stores")
    args = parser.parse_args()
    try:
        main_names, sidecar_names, _, _ = profile_sets()
        if args.verify:
            errors = verify_store(MAIN, main_names) + verify_store(SIDECAR, sidecar_names)
            for root in (MAIN, MAIN_CONTEXT, SIDECAR):
                for name in RETIRED:
                    if (root / f"{name}.md").exists():
                        errors.append(f"retired profile active: {root / (name + '.md')}")
            context_mlgo = sorted(MAIN_CONTEXT.glob("mlgo-*.md")) if MAIN_CONTEXT.exists() else []
            if context_mlgo:
                errors.append(f"stale MLGO profiles remain in agent-context: {[str(p) for p in context_mlgo]}")
            print(json.dumps({"ok": not errors, "action": "verify", "errors": errors}, sort_keys=True))
            return 0 if not errors else 1
        targets = [(MAIN, main_names), (SIDECAR, sidecar_names)]
        if args.main:
            targets = targets[:1]
        elif args.agy_sidecar:
            targets = targets[1:]
        results = [sync_store(dest, names, args.dry_run) for dest, names in targets]
        retired = clean_retired(args.dry_run)
        print(json.dumps({"ok": True, "action": "dry-run" if args.dry_run else "sync", "stores": results, "retired_removed": retired}, sort_keys=True))
        return 0
    except Exception as exc:
        print(json.dumps({"ok": False, "error": str(exc)}, sort_keys=True), file=sys.stderr)
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
