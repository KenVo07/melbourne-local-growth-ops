{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mlgo.local/schemas/break-glass-restart-approval.schema.json",
  "title": "MLGO CAO break-glass restart approval",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "action",
    "approved",
    "approved_by",
    "reason",
    "issued_at",
    "expires_at",
    "acknowledge_active_sessions_will_be_destroyed"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "action": {"const": "CAO_BREAK_GLASS_RESTART"},
    "approved": {"const": true},
    "approved_by": {"type": "string", "minLength": 1, "maxLength": 200},
    "reason": {"type": "string", "minLength": 10, "maxLength": 2000},
    "issued_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"},
    "acknowledge_active_sessions_will_be_destroyed": {"const": true}
  }
}
