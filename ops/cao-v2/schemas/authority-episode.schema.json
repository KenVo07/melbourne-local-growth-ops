{
  "$id": "https://mlgo.local/schemas/authority-episode.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "One durable episodic semantic-authority engagement, or a bounded pause/escalation when the episode ceiling is reached.",
  "properties": {
    "authority_mode": {
      "enum": [
        "CONSULT",
        "ADJUDICATE",
        "ESCALATE"
      ]
    },
    "authority_role": {
      "type": "string"
    },
    "budget_decision": {
      "type": [
        "object",
        "null"
      ]
    },
    "coalesced_event_count": {
      "minimum": 0,
      "type": "integer"
    },
    "coalesced_evidence_ids": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "created_at": {
      "type": "string"
    },
    "decision_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "dedupe_key": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "enforcement_mode": {
      "enum": [
        "shadow_only",
        "live"
      ]
    },
    "episode_digest": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "episode_id": {
      "maxLength": 128,
      "minLength": 1,
      "type": "string"
    },
    "episodes_used": {
      "type": "integer"
    },
    "evidence_ids": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "initiator": {
      "type": "string"
    },
    "limit_kind": {
      "type": "string"
    },
    "maximum_episodes": {
      "type": "integer"
    },
    "maximum_open_episodes": {
      "type": "integer"
    },
    "open_episodes": {
      "type": "integer"
    },
    "outcome": {
      "type": [
        "string",
        "null"
      ]
    },
    "resolved_at": {
      "type": "string"
    },
    "run_id": {
      "maxLength": 128,
      "minLength": 1,
      "type": "string"
    },
    "schema_version": {
      "const": "1.0"
    },
    "status": {
      "enum": [
        "OPEN",
        "RESOLVED",
        "PAUSED_ESCALATED"
      ]
    },
    "task_id": {
      "maxLength": 128,
      "minLength": 1,
      "type": "string"
    },
    "trigger_class": {
      "type": "string"
    },
    "trigger_digest": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "updated_at": {
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "episode_id",
    "run_id",
    "task_id",
    "trigger_class",
    "trigger_digest",
    "dedupe_key",
    "evidence_ids",
    "initiator",
    "authority_role",
    "authority_mode",
    "enforcement_mode",
    "status",
    "coalesced_event_count",
    "coalesced_evidence_ids",
    "created_at",
    "updated_at",
    "episode_digest"
  ],
  "title": "AuthorityEpisode",
  "type": "object"
}
