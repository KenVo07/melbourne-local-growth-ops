{
  "$id": "mlgo://cao-v2/run-contract-binding.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "binding_digest": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "build_id": {
      "minLength": 1,
      "type": "string"
    },
    "build_manifest_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "compatible_writer_ids": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "enabled_writers": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "minimum_reader_version": {
      "pattern": "^\\d+\\.\\d+\\.\\d+(?:[-+].*)?$",
      "type": "string"
    },
    "minimum_writer_version": {
      "pattern": "^\\d+\\.\\d+\\.\\d+(?:[-+].*)?$",
      "type": "string"
    },
    "policy_digest": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "registry_digest": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "runtime_version": {
      "minLength": 1,
      "type": "string"
    },
    "schema_bundle": {
      "additionalProperties": false,
      "properties": {
        "digest": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "files": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "name": {
                "minLength": 1,
                "type": "string"
              },
              "sha256": {
                "pattern": "^[0-9a-f]{64}$",
                "type": "string"
              }
            },
            "required": [
              "name",
              "sha256"
            ],
            "type": "object"
          },
          "minItems": 1,
          "type": "array"
        }
      },
      "required": [
        "files",
        "digest"
      ],
      "type": "object"
    },
    "schema_bundle_digest": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0"
    }
  },
  "required": [
    "schema_version",
    "runtime_version",
    "build_id",
    "build_manifest_sha256",
    "registry_digest",
    "policy_digest",
    "schema_bundle_digest",
    "enabled_writers",
    "minimum_reader_version",
    "minimum_writer_version",
    "compatible_writer_ids",
    "binding_digest",
    "schema_bundle"
  ],
  "title": "Run Contract Binding",
  "type": "object"
}
