{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mlgo://cao-v2/capacity-snapshot.schema.json",
  "title": "MLGO CAO v2 Capacity Snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "snapshot_id", "observed_at", "expires_at", "profiles"],
  "properties": {
    "schema_version": {"const": "2.0"},
    "snapshot_id": {"type": "string"},
    "observed_at": {"type": "string"},
    "expires_at": {"type": "string"},
    "profiles": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["availability", "capacity_band", "reserve_status", "billing_mode", "telemetry_confidence"],
        "properties": {
          "availability": {"enum": ["available", "degraded", "unavailable", "unknown", "policy_locked"]},
          "capacity_band": {"enum": ["abundant", "healthy", "constrained", "protected", "exhausted", "unknown"]},
          "remaining_pct": {"type": ["integer", "null"], "minimum": 0, "maximum": 100},
          "reserve_pct": {"type": ["integer", "null"], "minimum": 0, "maximum": 100},
          "reserve_status": {"enum": ["clear", "near", "protected", "not_applicable", "unknown"]},
          "billing_mode": {"enum": ["bundled", "subscription", "gateway"]},
          "gateway_authorized": {"type": "boolean"},
          "telemetry_confidence": {"enum": ["high", "medium", "low", "unknown"]},
          "evidence_source": {"type": "string"}
        }
      }
    }
  }
}
