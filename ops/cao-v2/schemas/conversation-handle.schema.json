{
  "$id": "https://mlgo.local/schemas/conversation-handle.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Immutable identity binding for one provider conversation generation. Identity mismatch must fail before any provider send.",
  "properties": {
    "account_profile_id": {
      "maxLength": 128,
      "minLength": 1,
      "type": "string"
    },
    "build_manifest_sha256": {
      "type": "string"
    },
    "cache_continuity_claim": {
      "const": "NOT_GUARANTEED"
    },
    "contract_bundle_digest": {
      "type": "string"
    },
    "created_at": {
      "type": "string"
    },
    "generation": {
      "minimum": 1,
      "type": "integer"
    },
    "handle_digest": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "handle_id": {
      "maxLength": 128,
      "minLength": 1,
      "type": "string"
    },
    "host_observation": {
      "type": "object"
    },
    "identity_digest": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "model": {
      "type": "string"
    },
    "policy_digest": {
      "type": "string"
    },
    "predecessor_handle_digest": {
      "type": [
        "string",
        "null"
      ]
    },
    "predecessor_handle_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "provider_conversation_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "provider_id": {
      "maxLength": 128,
      "minLength": 1,
      "type": "string"
    },
    "provider_profile_id": {
      "maxLength": 128,
      "minLength": 1,
      "type": "string"
    },
    "provider_session_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "reasoning_effort": {
      "type": "string"
    },
    "registry_digest": {
      "type": "string"
    },
    "resume_qualification": {
      "type": [
        "object",
        "null"
      ]
    },
    "role_id": {
      "maxLength": 128,
      "minLength": 1,
      "type": "string"
    },
    "run_id": {
      "maxLength": 128,
      "minLength": 1,
      "type": "string"
    },
    "runtime_version": {
      "type": "string"
    },
    "schema_version": {
      "const": "1.0"
    },
    "session_continuity_claim": {
      "enum": [
        "NONE_NEW_GENERATION",
        "LIVE_PROCESS_REATTACH",
        "NATIVE_PROVIDER_SESSION_RESUME"
      ]
    },
    "successor_reason": {
      "type": "string"
    },
    "task_id": {
      "maxLength": 128,
      "minLength": 1,
      "type": "string"
    },
    "terminal_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "transport_id": {
      "maxLength": 128,
      "minLength": 1,
      "type": "string"
    },
    "work_package_id": {
      "maxLength": 128,
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "handle_id",
    "run_id",
    "role_id",
    "work_package_id",
    "task_id",
    "provider_profile_id",
    "account_profile_id",
    "provider_id",
    "model",
    "reasoning_effort",
    "transport_id",
    "registry_digest",
    "policy_digest",
    "contract_bundle_digest",
    "runtime_version",
    "build_manifest_sha256",
    "generation",
    "session_continuity_claim",
    "cache_continuity_claim",
    "identity_digest",
    "handle_digest",
    "created_at"
  ],
  "title": "ConversationHandle",
  "type": "object"
}
