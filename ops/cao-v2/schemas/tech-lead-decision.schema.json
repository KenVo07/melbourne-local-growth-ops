{
  "$id": "https://mlgo.local/schemas/tech-lead-decision.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Authority response bound to the exact request revisions. CONSULT is advisory; ADJUDICATE is binding and applied exactly once; ESCALATE is never locally converted.",
  "properties": {
    "advice": {
      "type": [
        "string",
        "null"
      ]
    },
    "application_result": {
      "type": "object"
    },
    "applied_at_state_revision": {
      "type": "integer"
    },
    "applied_scope": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "authority_retained_by": {
      "type": [
        "string",
        "null"
      ]
    },
    "binding": {
      "type": "boolean"
    },
    "charter_revision": {
      "type": "string"
    },
    "checkpoint_digest": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "context_manifest_digest": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "created_at": {
      "type": "string"
    },
    "decided_by": {
      "type": [
        "string",
        "null"
      ]
    },
    "decision_digest": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "decision_id": {
      "maxLength": 128,
      "minLength": 1,
      "type": "string"
    },
    "delegation_revision": {
      "type": "string"
    },
    "mode": {
      "enum": [
        "CONSULT",
        "ADJUDICATE",
        "ESCALATE"
      ]
    },
    "observed_revisions": {
      "type": "object"
    },
    "outcome": {
      "type": "string"
    },
    "rationale_digest": {
      "type": [
        "string",
        "null"
      ]
    },
    "recorded_at": {
      "type": "string"
    },
    "request_binding_digest": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "request_id": {
      "maxLength": 128,
      "minLength": 1,
      "type": "string"
    },
    "requested_scope": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "run_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "schema_version": {
      "const": "1.0"
    },
    "state_mutations": {
      "minimum": 0,
      "type": "integer"
    },
    "state_revision": {
      "minimum": 0,
      "type": "integer"
    },
    "status": {
      "enum": [
        "APPLIED",
        "ADVISORY_RECORDED",
        "ESCALATION_RECORDED",
        "STALE_DECISION"
      ]
    },
    "task_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "worker_dispatches": {
      "minimum": 0,
      "type": "integer"
    }
  },
  "required": [
    "schema_version",
    "decision_id",
    "request_id",
    "mode",
    "outcome",
    "applied_scope",
    "requested_scope",
    "state_revision",
    "context_manifest_digest",
    "checkpoint_digest",
    "delegation_revision",
    "charter_revision",
    "request_binding_digest",
    "binding",
    "created_at",
    "decision_digest"
  ],
  "title": "TechLeadDecision",
  "type": "object"
}
