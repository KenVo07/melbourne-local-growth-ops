{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mlgo://cao-v2/wb0-state-generation.schema.json",
  "title": "WB-0 State Generation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "generation_id",
    "state_schema",
    "created_at",
    "source_generation_id",
    "source_release_id",
    "compatible_release_ids",
    "writable_by_release_ids",
    "immutable",
    "initial_seed",
    "generation_digest"
  ],
  "properties": {
    "schema_version": {"const": "1.1"},
    "generation_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
    "state_schema": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": {"const": "mlgo-cao-v2-control-state"},
        "version": {"type": "string", "minLength": 1}
      }
    },
    "created_at": {"type": "string", "format": "date-time"},
    "source_generation_id": {"type": ["string", "null"]},
    "source_release_id": {"type": "string"},
    "compatible_release_ids": {
      "type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}
    },
    "writable_by_release_ids": {
      "type": "array", "uniqueItems": true, "items": {"type": "string"}
    },
    "immutable": {"type": "boolean"},
    "initial_seed": {
      "type": "object",
      "additionalProperties": false,
      "required": ["payload_root_mode", "payload_entries", "payload_digest"],
      "properties": {
        "payload_root_mode": {"type": "string", "pattern": "^0[0-7]{3}$"},
        "payload_entries": {"type": "array"},
        "payload_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "generation_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "description": "Immutable generation identity and initial-seed evidence. Golden generations continuously verify the sealed payload; writable generations may evolve after first activation without changing immutable identity metadata."
}
