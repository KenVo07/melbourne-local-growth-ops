{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mlgo://cao-v2/host-decision-provenance.schema.json",
  "title": "Host-Captured Supervisor Decision",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "record_type", "run_id", "decision_id", "decision_digest", "decision", "provenance"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "record_type": {"const": "HOST_CAPTURED_SUPERVISOR_DECISION"},
    "run_id": {"type": "string"},
    "decision_id": {"type": "string"},
    "decision_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "decision": {"type": "object"},
    "provenance": {
      "type": "object",
      "required": [
        "supervisor_profile", "supervisor_generation", "terminal_id", "provider",
        "delivery_id", "observed_message_id", "observation_source", "observation_trust",
        "artifact_path", "artifact_sha256", "artifact_record_sha256", "adapter",
        "response_text_sha256", "captured_at"
      ],
      "properties": {
        "observation_trust": {"const": "HOST_PARSED_PROVIDER_ARTIFACT"},
        "artifact_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "artifact_record_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }
  }
}
