{
  "$id": "https://mlgo.local/schemas/tech-lead-consult-request.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "CONSULT/ADJUDICATE/ESCALATE request bound to exact state, context, checkpoint and delegation revisions.",
  "properties": {
    "authority_retained_by": {
      "type": [
        "string",
        "null"
      ]
    },
    "authority_role": {
      "type": "string"
    },
    "big_task_id": {
      "maxLength": 128,
      "minLength": 1,
      "type": "string"
    },
    "binding_digest": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "charter_revision": {
      "type": "string"
    },
    "checkpoint_digest": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "context_manifest_digest": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "conversation_handle_digest": {
      "type": [
        "string",
        "null"
      ]
    },
    "created_at": {
      "type": "string"
    },
    "delegated_scope": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "delegation_revision": {
      "type": "string"
    },
    "episode_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "evidence_refs": {
      "items": {
        "type": "object"
      },
      "type": "array"
    },
    "execution_state_digest": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "mode": {
      "enum": [
        "CONSULT",
        "ADJUDICATE",
        "ESCALATE"
      ]
    },
    "question": {
      "type": "string"
    },
    "request_digest": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "request_id": {
      "maxLength": 128,
      "minLength": 1,
      "type": "string"
    },
    "requested_scope": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "type": "array"
    },
    "requester_role": {
      "type": "string"
    },
    "run_id": {
      "maxLength": 128,
      "minLength": 1,
      "type": "string"
    },
    "schema_version": {
      "const": "1.0"
    },
    "state_revision": {
      "minimum": 0,
      "type": "integer"
    },
    "supersedes_request_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "task_id": {
      "maxLength": 128,
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "request_id",
    "run_id",
    "task_id",
    "big_task_id",
    "requester_role",
    "authority_role",
    "mode",
    "requested_scope",
    "delegated_scope",
    "state_revision",
    "context_manifest_digest",
    "checkpoint_digest",
    "delegation_revision",
    "charter_revision",
    "question",
    "evidence_refs",
    "binding_digest",
    "request_digest",
    "created_at"
  ],
  "title": "TechLeadAuthorityRequest",
  "type": "object"
}
