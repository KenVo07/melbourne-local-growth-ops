{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mlgo://cao-v2/checkpoint-fallback-approval.schema.json",
  "title": "Checkpoint Fallback Approval",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "action", "run_id", "approved", "approved_by", "reason", "issued_at", "expires_at"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "action": {"const": "CHECKPOINT_FALLBACK_NEW_GENERATION"},
    "run_id": {"type": "string"},
    "approved": {"const": true},
    "approved_by": {"type": "string", "minLength": 1},
    "reason": {"type": "string", "minLength": 10},
    "issued_at": {"type": "string"},
    "expires_at": {"type": "string"}
  }
}
