{
  "$id": "https://mlgo.local/cao-v2/event-outbox-intent.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "description": "One Event intent written inside the same durable owner-ledger commit as the fact it describes. Intents are the transactional outbox: they are never written independently of the owner ledger.",
  "properties": {
    "artifact_refs": {
      "items": {
        "properties": {
          "artifact_id": {
            "type": "string"
          },
          "byte_size": {
            "type": "integer"
          },
          "classification": {
            "type": "string"
          },
          "content_hash": {
            "type": "string"
          },
          "ref_digest": {
            "type": "string"
          },
          "security_domain_id": {
            "type": "string"
          }
        },
        "required": [
          "artifact_id",
          "security_domain_id",
          "content_hash",
          "ref_digest"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "causation_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "correlation_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "cursor_token": {
      "description": "Owner-ledger position this intent was committed at.",
      "type": "string"
    },
    "discriminator": {
      "description": "Distinguishes several Events emitted by one Command.",
      "type": "string"
    },
    "event_id": {
      "pattern": "^ev-[0-9a-f]{40}$",
      "type": "string"
    },
    "event_type": {
      "type": "string"
    },
    "intent_digest": {
      "type": "string"
    },
    "intent_schema_version": {
      "const": "1.0"
    },
    "occurred_at": {
      "type": "string"
    },
    "payload": {
      "type": "object"
    },
    "run_id": {
      "type": "string"
    },
    "source": {
      "enum": [
        "run_store",
        "operation_ledger"
      ]
    }
  },
  "required": [
    "intent_schema_version",
    "event_id",
    "source",
    "run_id",
    "cursor_token",
    "event_type",
    "discriminator",
    "payload",
    "occurred_at",
    "intent_digest"
  ],
  "title": "CAO v2 Event Outbox Intent",
  "type": "object"
}
