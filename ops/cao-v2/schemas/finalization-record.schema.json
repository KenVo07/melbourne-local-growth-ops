{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mlgo://cao-v2/finalization-record.schema.json",
  "title": "MLGO CAO v2.1 Finalization Record",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "local_integration_sha", "remote_target", "remote_sha", "target_reachable", "required_review_satisfied", "final_validation_satisfied", "remote_ci_satisfied", "publication_satisfied", "final_facts_record", "final_facts_digest", "supervisor_decision_provenance", "supervisor_verdict", "unresolved_blockers", "cleanup_eligible", "recorded_at"],
  "properties": {
    "schema_version": {"const": "2.1"},
    "run_id": {"type": "string"},
    "local_integration_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "remote_target": {"type": "string"},
    "remote_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "target_reachable": {"const": true},
    "required_review_satisfied": {"const": true},
    "final_validation_satisfied": {"const": true},
    "remote_ci_satisfied": {"type": "boolean"},
    "publication_satisfied": {"type": "boolean"},
    "final_facts_record": {"type": "string"},
    "final_facts_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "supervisor_decision_provenance": {"type": "string"},
    "supervisor_verdict": {"const": "MILESTONE_FINALIZED"},
    "unresolved_blockers": {"type": "array", "items": {"type": "string"}, "maxItems": 0},
    "cleanup_eligible": {"const": true},
    "recorded_at": {"type": "string"}
  }
}
