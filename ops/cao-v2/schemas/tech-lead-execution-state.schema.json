{
  "$id": "https://mlgo.local/schemas/tech-lead-execution-state.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Compact but complete normalized Tech Lead coordination state.",
  "properties": {
    "big_task_id": {
      "maxLength": 128,
      "minLength": 1,
      "type": "string"
    },
    "charter_revision": {
      "minLength": 1,
      "type": "string"
    },
    "completed_task_ids": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "cursors": {
      "type": "object"
    },
    "decisions": {
      "items": {
        "type": "object"
      },
      "type": "array"
    },
    "delegation_revision": {
      "minLength": 1,
      "type": "string"
    },
    "dependencies": {
      "items": {
        "type": "object"
      },
      "type": "array"
    },
    "evidence_refs": {
      "items": {
        "type": "object"
      },
      "type": "array"
    },
    "generation": {
      "minimum": 1,
      "type": "integer"
    },
    "last_committed_state_version": {
      "minimum": 0,
      "type": "integer"
    },
    "ownership": {
      "additionalProperties": false,
      "properties": {
        "files": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "workers": {
          "type": "array"
        },
        "worktrees": {
          "type": "array"
        }
      },
      "required": [
        "workers",
        "files",
        "worktrees"
      ],
      "type": "object"
    },
    "risks": {
      "items": {
        "type": "object"
      },
      "type": "array"
    },
    "run_id": {
      "maxLength": 128,
      "minLength": 1,
      "type": "string"
    },
    "schema_version": {
      "const": "1.0"
    },
    "state_digest": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "task_graph": {
      "items": {
        "required": [
          "task_id",
          "status",
          "depends_on"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "task_id": {
      "maxLength": 128,
      "minLength": 1,
      "type": "string"
    },
    "task_lead_id": {
      "maxLength": 128,
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "run_id",
    "big_task_id",
    "task_id",
    "task_lead_id",
    "generation",
    "task_graph",
    "ownership",
    "evidence_refs",
    "decisions",
    "risks",
    "dependencies",
    "delegation_revision",
    "charter_revision",
    "cursors",
    "last_committed_state_version",
    "completed_task_ids",
    "state_digest"
  ],
  "title": "TechLeadExecutionState",
  "type": "object"
}
