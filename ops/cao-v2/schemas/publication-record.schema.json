{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mlgo://cao-v2/publication-record.schema.json",
  "title": "MLGO CAO v2 Publication Record",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "candidate_sha", "remote", "target_branch", "status", "recorded_at"],
  "properties": {
    "schema_version": {"const": "2.0"},
    "run_id": {"type": "string"},
    "candidate_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "remote": {"type": "string"},
    "target_branch": {"type": "string"},
    "status": {"enum": ["PUBLISHED", "NOT_REQUIRED", "FAILED"]},
    "pull_request_url": {"type": ["string", "null"]},
    "recorded_at": {"type": "string"}
  }
}
