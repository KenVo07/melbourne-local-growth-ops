{
  "$id": "mlgo://cao-v2/command-outcome.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "properties": {
    "command_id": {
      "type": "string"
    },
    "status": {
      "enum": [
        "PREPARED",
        "DISPATCHING",
        "NOT_SENT_CONFIRMED",
        "UNKNOWN_AFTER_SUBMIT",
        "ACCEPTED",
        "OBSERVED_IN_PROGRESS",
        "COMPLETED",
        "RECONCILIATION_REQUIRED",
        "BLOCKED_MANUAL",
        "FAILED",
        "CANCELLED"
      ]
    }
  },
  "required": [
    "command_id",
    "status"
  ],
  "title": "Command Outcome",
  "type": "object"
}
