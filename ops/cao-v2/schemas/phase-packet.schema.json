{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mlgo://cao-v2/phase-packet.schema.json",
  "title": "MLGO CAO v2 Phase Packet",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "big_task_id",
    "phase_id",
    "phase_kind",
    "objective",
    "write_capable",
    "prompt_file",
    "routing_proposal_file",
    "evidence_directory",
    "validation",
    "result_contract",
    "stop_conditions"
  ],
  "properties": {
    "schema_version": {
      "const": "2.0"
    },
    "run_id": {
      "type": "string"
    },
    "big_task_id": {
      "type": "string"
    },
    "phase_id": {
      "type": "string"
    },
    "phase_kind": {
      "enum": [
        "implementation",
        "review",
        "analysis",
        "validation",
        "integration_repair"
      ]
    },
    "objective": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "write_capable": {
      "type": "boolean"
    },
    "prompt_file": {
      "type": "string"
    },
    "routing_proposal_file": {
      "type": "string"
    },
    "worktree": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "path",
        "branch",
        "base_ref",
        "create_if_missing",
        "require_clean"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "branch": {
          "type": "string"
        },
        "base_ref": {
          "type": "string"
        },
        "create_if_missing": {
          "type": "boolean"
        },
        "require_clean": {
          "type": "boolean"
        }
      }
    },
    "ownership": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "allowed_paths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "forbidden_paths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "evidence_directory": {
      "type": "string"
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "commands",
        "timeout_seconds"
      ],
      "properties": {
        "commands": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "timeout_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 14400
        },
        "reuse_evidence_for_sha": {
          "type": "boolean"
        }
      }
    },
    "result_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "allowed_statuses"
      ],
      "properties": {
        "allowed_statuses": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "READY_FOR_COMMIT",
              "NO_CHANGE",
              "PASS",
              "FAIL",
              "BLOCKED",
              "PLAN_CONFLICT",
              "CAPABILITY_ESCALATION_REQUIRED",
              "ENVIRONMENT_BLOCKED",
              "MISSING_REQUIRED_CONTEXT"
            ]
          }
        }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "required": {
          "type": "boolean"
        },
        "phase_packet_file": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "integration": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "integration_worktree": {
          "type": [
            "string",
            "null"
          ]
        },
        "integration_branch": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "task_lead": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "task_lead_id": {
          "type": "string"
        },
        "terminal_id": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "stop_conditions": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "string",
        "maxLength": 512
      }
    },
    "rollback_boundary": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 2048
    },
    "parent_phase_id": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}
