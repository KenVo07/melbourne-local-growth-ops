{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mlgo://cao-v2/semantic-exception.schema.json",
  "title": "MLGO CAO v2 Semantic Exception",
  "type": "object",
  "additionalProperties": true,
  "required": ["schema_version", "exception_id", "run_id", "big_task_id", "phase_id", "class", "reason", "authority_required", "created_at"],
  "properties": {
    "schema_version": {"const": "2.0"},
    "exception_id": {"type": "string"},
    "run_id": {"type": "string"},
    "big_task_id": {"type": "string"},
    "phase_id": {"type": "string"},
    "class": {"type": "string"},
    "reason": {"type": "string"},
    "verified_facts": {"type": "array", "items": {"type": "string"}},
    "invalidated_assumption": {"type": ["string", "null"]},
    "available_choices": {"type": "array", "items": {"type": "string"}},
    "authority_required": {"enum": ["task_lead", "authoritative_supervisor", "operator"]},
    "quality_impact": {"type": ["string", "null"]},
    "budget_impact": {"type": ["string", "null"]},
    "created_at": {"type": "string"}
  }
}
