{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mlgo://cao-v2/validation-reuse-promotion.schema.json",
  "title": "Validation Evidence Reuse Promotion",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "action", "approved", "approved_by", "fingerprint_version", "observations", "false_hits", "issued_at", "expires_at"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "action": {"const": "PROMOTE_VALIDATION_EVIDENCE_REUSE"},
    "approved": {"const": true},
    "approved_by": {"type": "string"},
    "fingerprint_version": {"const": "2.0"},
    "observations": {"type": "integer", "minimum": 1},
    "false_hits": {"const": 0},
    "issued_at": {"type": "string"},
    "expires_at": {"type": "string"}
  }
}
