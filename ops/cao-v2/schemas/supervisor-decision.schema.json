{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mlgo://cao-v2/supervisor-decision.schema.json",
  "title": "MLGO CAO v2.1 Supervisor Decision Payload",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "decision_id", "run_id", "supervisor_profile", "decision_type", "facts", "decision", "authority_basis", "conditions", "remaining_risk", "decided_at"],
  "properties": {
    "schema_version": {"const": "2.1"},
    "decision_id": {"type": "string"},
    "run_id": {"type": "string"},
    "big_task_id": {"type": ["string", "null"]},
    "decision_type": {"enum": ["CHARTER_APPROVAL", "EXCEPTION_DISPOSITION", "INTEGRATION_AUTHORIZATION", "PUBLICATION_AUTHORIZATION", "FINAL_VERDICT"]},
    "facts": {"type": "array", "items": {"type": "string"}},
    "decision": {"type": "string"},
    "authority_basis": {"type": "string"},
    "conditions": {"type": "array", "items": {"type": "string"}},
    "remaining_risk": {"type": "array", "items": {"type": "string"}},
    "decided_at": {"type": "string"},
    "supervisor_profile": {"type": "string"},
    "candidate_sha": {"type": ["string", "null"], "pattern": "^[0-9a-f]{40}$"},
    "facts_digest": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"}
  }
}
