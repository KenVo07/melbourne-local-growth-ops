{
  "$id": "https://mlgo.local/cao-v2/usage-record-v2.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "description": "Provider-neutral usage. Metrics are an extensible list in provider-native units. Missing provider telemetry is recorded as UNAVAILABLE and never estimated, and incompatible native units are never collapsed into a universal token or cost equivalent.",
  "minProperties": 1,
  "properties": {
    "account_profile_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "budget_enforcement_eligible": {
      "type": "boolean"
    },
    "command_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "correlation": {
      "type": "object"
    },
    "episode_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "exact_correlation": {
      "type": "boolean"
    },
    "metrics": {
      "items": {
        "allOf": [
          {
            "if": {
              "properties": {
                "availability": {
                  "enum": [
                    "UNAVAILABLE",
                    "NOT_APPLICABLE"
                  ]
                }
              }
            },
            "then": {
              "properties": {
                "value": {
                  "type": "null"
                }
              }
            }
          }
        ],
        "description": "One provider-native measurement, or an explicit statement that it is unavailable.",
        "properties": {
          "availability": {
            "enum": [
              "MEASURED",
              "PROVIDER_REPORTED",
              "UNAVAILABLE",
              "NOT_APPLICABLE"
            ]
          },
          "confidence": {
            "enum": [
              "exact",
              "high",
              "medium",
              "low",
              "unavailable"
            ]
          },
          "estimated": {
            "const": false
          },
          "metric": {
            "type": "string"
          },
          "native_unit": {
            "description": "Provider-native unit; never converted.",
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "value": {
            "type": [
              "number",
              "null"
            ]
          }
        },
        "required": [
          "metric",
          "native_unit",
          "availability",
          "confidence",
          "source"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "milestone_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "model": {
      "type": [
        "string",
        "null"
      ]
    },
    "normalized_estimate": {
      "description": "Optional secondary currency estimate. Never replaces native values.",
      "properties": {
        "amount": {
          "type": "number"
        },
        "basis": {
          "type": "string"
        },
        "confidence": {
          "type": "string"
        },
        "currency": {
          "type": "string"
        },
        "is_estimate": {
          "const": true
        },
        "replaces_native_values": {
          "const": false
        },
        "secondary": {
          "const": true
        },
        "source": {
          "type": "string"
        }
      },
      "required": [
        "currency",
        "amount",
        "source",
        "confidence",
        "is_estimate",
        "secondary"
      ],
      "type": [
        "object",
        "null"
      ]
    },
    "observed_at": {
      "type": "string"
    },
    "provider_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "provider_profile_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "record_digest": {
      "type": "string"
    },
    "role": {
      "type": [
        "string",
        "null"
      ]
    },
    "run_id": {
      "type": "string"
    },
    "schema_version": {
      "const": "2.0"
    },
    "source": {
      "type": "string"
    },
    "task_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "transport_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "usage_record_id": {
      "type": "string"
    },
    "work_package_id": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "schema_version",
    "usage_record_id",
    "run_id",
    "metrics",
    "observed_at",
    "record_digest"
  ],
  "title": "CAO v2 UsageRecord v2",
  "type": "object"
}
