{
  "$id": "https://mlgo.local/schemas/checkpoint-vnext.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Immutable compact checkpoint. Tamper, cursor gap, identity mismatch and unsupported schema all fail closed.",
  "properties": {
    "cache_continuity_claim": {
      "const": "NOT_GUARANTEED"
    },
    "checkpoint_id": {
      "maxLength": 128,
      "minLength": 1,
      "type": "string"
    },
    "content_digest": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "contract_bundle_digest": {
      "type": "string"
    },
    "conversation_handle_digest": {
      "type": [
        "string",
        "null"
      ]
    },
    "created_at": {
      "type": "string"
    },
    "cursors": {
      "additionalProperties": false,
      "properties": {
        "command_cursor": {
          "additionalProperties": false,
          "properties": {
            "available": {
              "type": "boolean"
            },
            "count": {
              "minimum": 0,
              "type": "integer"
            },
            "last_id": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "count",
            "last_id",
            "available"
          ],
          "type": "object"
        },
        "event_cursor": {
          "additionalProperties": false,
          "properties": {
            "available": {
              "type": "boolean"
            },
            "count": {
              "minimum": 0,
              "type": "integer"
            },
            "last_id": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "count",
            "last_id",
            "available"
          ],
          "type": "object"
        },
        "operation_cursor": {
          "additionalProperties": false,
          "properties": {
            "available": {
              "type": "boolean"
            },
            "count": {
              "minimum": 0,
              "type": "integer"
            },
            "last_id": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "count",
            "last_id",
            "available"
          ],
          "type": "object"
        },
        "state_version": {
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "state_version",
        "command_cursor",
        "operation_cursor",
        "event_cursor"
      ],
      "type": "object"
    },
    "evidence_refs": {
      "items": {
        "type": "object"
      },
      "type": "array"
    },
    "last_committed_state_version": {
      "minimum": 0,
      "type": "integer"
    },
    "locked_decisions": {
      "items": {
        "type": "object"
      },
      "type": "array"
    },
    "normalized_state": {
      "type": "object"
    },
    "normalized_state_digest": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "open_risks": {
      "items": {
        "type": "object"
      },
      "type": "array"
    },
    "policy_digest": {
      "type": "string"
    },
    "predecessor_checkpoint_digest": {
      "type": [
        "string",
        "null"
      ]
    },
    "predecessor_checkpoint_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "projected_from_checkpoint_digest": {
      "type": "string"
    },
    "registry_digest": {
      "type": "string"
    },
    "role_id": {
      "maxLength": 128,
      "minLength": 1,
      "type": "string"
    },
    "run_id": {
      "maxLength": 128,
      "minLength": 1,
      "type": "string"
    },
    "schema_version": {
      "const": "1.0"
    },
    "source_generation": {
      "minimum": 1,
      "type": "integer"
    },
    "state_schema_version": {
      "type": "string"
    },
    "successor_checkpoint_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "task_id": {
      "maxLength": 128,
      "minLength": 1,
      "type": "string"
    },
    "work_package_id": {
      "maxLength": 128,
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "checkpoint_id",
    "run_id",
    "role_id",
    "work_package_id",
    "task_id",
    "source_generation",
    "state_schema_version",
    "normalized_state",
    "normalized_state_digest",
    "registry_digest",
    "policy_digest",
    "contract_bundle_digest",
    "last_committed_state_version",
    "cursors",
    "locked_decisions",
    "open_risks",
    "evidence_refs",
    "predecessor_checkpoint_id",
    "predecessor_checkpoint_digest",
    "successor_checkpoint_id",
    "cache_continuity_claim",
    "content_digest",
    "created_at"
  ],
  "title": "CheckpointVNext",
  "type": "object"
}
