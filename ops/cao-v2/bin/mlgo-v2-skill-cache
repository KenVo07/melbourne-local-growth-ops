#!/usr/bin/env bash
set -euo pipefail
export PYTHONPATH="${MLGO_CAO_V2_LIB:-$HOME/.local/lib/mlgo-cao-v2}:${PYTHONPATH:-}"
case "${1:-}" in
  plan) shift; exec python3 -m mlgo_cao_v2.cli skill-cache-plan "$@" ;;
  populate) shift; exec python3 -m mlgo_cao_v2.cli skill-cache-populate "$@" ;;
  verify-mirror) shift; exec python3 -m mlgo_cao_v2.cli skill-cache-verify-mirror "$@" ;;
  *) exec python3 -m mlgo_cao_v2.cli "$@" ;;
esac
