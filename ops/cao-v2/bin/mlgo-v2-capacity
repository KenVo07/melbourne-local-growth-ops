#!/usr/bin/env bash
set -euo pipefail
export PYTHONPATH="${MLGO_CAO_V2_LIB:-$HOME/.local/lib/mlgo-cao-v2}:${PYTHONPATH:-}"
case "${1:-}" in
  hint) shift; exec python3 -m mlgo_cao_v2.cli capacity-hint "$@" ;;
  snapshot) shift; exec python3 -m mlgo_cao_v2.cli capacity "$@" ;;
  *) exec python3 -m mlgo_cao_v2.cli capacity "$@" ;;
esac
